<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->

   <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <Button
        android:id="@+id/backButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="←"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clap2ESP32 Settings"
        android:textStyle="bold"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NETWORK -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="28dp"/>

    <EditText
        android:id="@+id/ipEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ESP Address"/>

   <!-- COMMANDS -->

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Commands"
    android:textStyle="bold"
    android:textSize="18sp"
    android:layout_marginTop="24dp"/>

<!-- Toggle -->

<LinearLayout
    android:id="@+id/toggleLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/togglePathEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Toggle Path"/>

</LinearLayout>

<!-- Primary / Secondary -->

<LinearLayout
    android:id="@+id/onOffLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/primaryPathEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Primary Path"/>

    <EditText
        android:id="@+id/secondaryPathEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Secondary Path"/>

</LinearLayout>

<!-- Secondary Sequence -->

<LinearLayout
    android:id="@+id/sequenceLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secondary Sequence"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"/>

    <RadioGroup
        android:id="@+id/sequenceGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/doubleSingle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Double → Single"/>

        <RadioButton
            android:id="@+id/singleDouble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single → Double"/>

    </RadioGroup>

</LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"/>

    <RadioGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/toggleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle"/>

        <RadioButton
            android:id="@+id/onOffMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary / Secondary"/>

    </RadioGroup>

  
       <!-- DETECTOR -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detector"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"/>

    <CheckBox
        android:id="@+id/manualTimeout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manual timeout"/>

    <EditText
        android:id="@+id/timeoutEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Timeout (ms)"
        android:inputType="number"/>

    <CheckBox
        android:id="@+id/vibrationCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vibration"/>

    <!-- LOGS -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logs"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"/>

    <CheckBox
        android:id="@+id/systemLogCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System"/>

    <CheckBox
        android:id="@+id/audioLogCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio"/>

    <CheckBox
        android:id="@+id/networkLogCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network"/>

    <CheckBox
        android:id="@+id/debugLogCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Debug"/>

    <!-- INTERFACE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interface"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"/>

    <CheckBox
        android:id="@+id/connectionCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection indicator"/>

    <!-- TEST BUTTONS -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection Test"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="28dp"/>

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Test Toggle"/>

    <Button
        android:id="@+id/testPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Test Primary"/>

    <Button
        android:id="@+id/testSecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Test Secondary"/>

    <!-- SAVE -->

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Settings"
        android:textStyle="bold"/>

    <!-- VERSION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Clap2ESP32 v0.3"
        android:textColor="#888"/>

</LinearLayout>
</ScrollView>
